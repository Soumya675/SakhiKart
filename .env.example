# Data layer mode: "demo" uses in-memory/localStorage demo repositories.
# Set to "production" once Supabase repositories are connected.
VITE_DATA_MODE="demo"

# Future Supabase integration (Phase 2)
VITE_SUPABASE_URL="MY_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# Future Payment & Shipping gateways (Server-side / Phase 2)
RAZORPAY_KEY_ID="MY_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="MY_RAZORPAY_KEY_SECRET"
SHIPPING_API_KEY="MY_SHIPPING_API_KEY"

# Gemini API for Seller Voice Input & Cataloging Assistant (Server-side)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL
APP_URL="MY_APP_URL"
